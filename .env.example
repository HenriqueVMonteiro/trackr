# Database (Supabase Postgres connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trackr

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis REST (cache de busca)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Redis TCP para BullMQ/webhooks (Upstash "Redis URL", formato rediss://...)
# Se não for definido, webhooks usam fila em memória no processo Next.
UPSTASH_REDIS_URL=rediss://default:password@your-redis.upstash.io:6379

# Email (Resend) - usado pelo Agente B no stint B5
RESEND_API_KEY=your-resend-key

# Web Push VAPID - usado pelo Agente B no stint B5
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:dev@trackr.local

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
